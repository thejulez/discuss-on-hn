{
  "manifest_version": 3,
  "name": "Discuss on HN",
  "version": "1.14.0",
  "description": "Join the Hacker News conversation about any page: chime in, start it if it's missing, never double-post, never miss a reply.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Discuss on HN",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Alt+Shift+Y"
      },
      "description": "Open / close the Discuss on HN panel"
    }
  }
}
